{
  "name": "zotero-neo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Keyboard-first Zotero interaction layer",
  "scripts": {
    "build": "node tools/build.mjs",
    "format": "prettier --write src tests tools/*.mjs *.json *.ts",
    "format:check": "prettier --check src tests tools/*.mjs *.json *.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false && tsc -p tsconfig.test.json --noEmit --pretty false",
    "test": "vitest run",
    "verify": "node tools/verify.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitest": "4.1.3",
    "zotero-types": "4.1.3"
  }
}
