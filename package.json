{
  "name": "zotero-neo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Keyboard-first Zotero interaction layer",
  "scripts": {
    "build": "node tools/build.mjs",
    "dev": "npm run build && node tools/dev-gui.mjs reload",
    "dev:start": "npm run build && node tools/dev-gui.mjs start",
    "dev:setup": "npm run build && node tools/dev-gui.mjs setup",
    "dev:status": "node tools/dev-gui.mjs status",
    "format": "prettier --write src tests tools/*.mjs *.json *.ts \".vitepress/**/*.{ts,vue,css}\" \"prototypes/reading-assistant/**/*.{js,css,html,json}\"",
    "format:check": "prettier --check src tests tools/*.mjs *.json *.ts \".vitepress/**/*.{ts,vue,css}\" \"prototypes/reading-assistant/**/*.{js,css,html,json}\"",
    "docs:dev": "vitepress dev .",
    "docs:build": "vitepress build .",
    "docs:preview": "vitepress preview .",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false && tsc -p tsconfig.test.json --noEmit --pretty false",
    "test": "vitest run",
    "verify": "node tools/verify.mjs",
    "prototype:reader": "node tools/preview-reader-assistant.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitepress": "1.6.4",
    "vitest": "4.1.3",
    "zotero-types": "4.1.3"
  }
}
