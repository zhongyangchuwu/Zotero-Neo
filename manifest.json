{
  "manifest_version": 2,
  "name": "Zotero Neo",
  "version": "0.1.0",
  "description": "A Neovim-inspired, keyboard-first interaction layer for navigating, reading, annotating, and managing research in Zotero.",
  "author": "ZorroStardust, Alex Fink (original author)",
  "homepage_url": "https://github.com/zhongyangchuwu/Zotero-Neo",
  "icons": {
    "64": "icons/icon-64x64.png",
    "128": "icons/icon-128x128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "zotero-neo@zotero-neo",
      "update_url": "https://raw.githubusercontent.com/zhongyangchuwu/Zotero-Neo/main/updates.json"
    }
  },
  "applications": {
    "zotero": {
      "id": "zotero-neo@zotero-neo",
      "update_url": "https://raw.githubusercontent.com/zhongyangchuwu/Zotero-Neo/main/updates.json",
      "strict_min_version": "7.0",
      "strict_max_version": "10.*"
    }
  }
}
